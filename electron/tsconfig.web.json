{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "target": "ES2020",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/*"],
      "@shared/*": ["src/shared/*"],
      "@unlock/decrypt": ["src/renderer/lib/types/unlock-music.d.ts"],
      "@unlock/decrypt/entity": ["src/renderer/lib/types/unlock-music.d.ts"],
      "@unlock/utils/utils": ["src/renderer/lib/types/unlock-music.d.ts"],
      "@unlock/utils/storage": ["src/renderer/lib/types/unlock-music.d.ts"]
    }
  },
  "include": [
    "src/renderer/**/*",
    "src/shared/**/*",
    "src/preload/index.d.ts"
  ]
}
